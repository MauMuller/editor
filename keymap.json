[
  {
    "context": "Workspace && vim_mode == normal",
    "bindings": {
      "space t n": "workspace::NewFile",
      "space e": "project_panel::Toggle",
      "ctrl-w": null,
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "alt-right": "pane::ActivateNextItem",
      "alt-left": "pane::ActivatePreviousItem",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "alt-shift-left": "pane::SwapItemLeft",
      "alt-shift-right": "pane::SwapItemRight",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-a": "project_panel::NewFile",
      "ctrl-shift-a": "project_panel::NewDirectory",
      "ctrl-r": "project_panel::Rename",
      "ctrl-d": "project_panel::Delete",
      "ctrl-y": "project_panel::Copy",
      "ctrl-x": "project_panel::Cut",
      "ctrl-p": "project_panel::Paste",
      "space e": "project_panel::Toggle",
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "space l k": "editor::Hover",
      "space l ç": "editor::GoToDefinition",
      "space l d": "editor::GoToDiagnostic",
      "ctrl-'": "terminal_panel::ToggleFocus",
      "space f f": "file_finder::Toggle",
      "space f g": "text_finder::Toggle",
      "space e": "project_panel::ToggleFocus",
      "space b t": "workspace::NewFile",
      "space b q": "pane::CloseActiveItem",
    },
  },
  {
    "context": "Dock",
    "bindings": {
      "ctrl-w left": "workspace::ActivatePaneLeft",
      "ctrl-w right": "workspace::ActivatePaneRight",
      "ctrl-w up": "workspace::ActivatePaneUp",
      "ctrl-w down": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-'": "terminal_panel::Toggle",
      "ctrl-t": ["terminal::SendKeystroke", "ctrl-t"],
      "ctrl-g": ["terminal::SendKeystroke", "ctrl-g"],
      "ctrl-p": ["terminal::SendKeystroke", "ctrl-p"],
      "ctrl-n": ["terminal::SendKeystroke", "ctrl-n"],
      "ctrl-s": ["terminal::SendKeystroke", "ctrl-s"],
      "ctrl-o": ["terminal::SendKeystroke", "ctrl-o"],
      "alt-right": ["terminal::SendKeystroke", "alt-right"],
      "alt-left": ["terminal::SendKeystroke", "alt-left"],
    },
  },

  // Unbinds
  {
    "unbind": {
      "ctrl-q": "zed::Quit",
    },
  },
  {
    "context": "!SettingsWindow",
    "unbind": {
      "ctrl-,": "zed::OpenSettings",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "unbind": {
      "p": "project_panel::Open",
    },
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-o": "pane::GoBack",
    },
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-i": "pane::GoForward",
    },
  },
  {
    "unbind": {
      "ctrl-alt-,": "zed::OpenSettingsFile",
    },
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-shift-space": "terminal::ToggleViMode",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-`": "terminal_panel::Toggle",
    },
  },
  {
    "unbind": {
      "ctrl-o": "workspace::OpenFiles",
    },
  },
]
